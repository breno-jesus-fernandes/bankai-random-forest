+#[allow(clippy::too_many_arguments)]
+fn best_random_split_binary_refined(
+    input: &DenseInput, mask: &Mask, feature: usize, target: &DenseDecisionSlice,
+    monotonic_constraint: i8, lower_bound: f64, upper_bound: f64, rng: &mut RfRng,
+    split_cache: &DenseSplitCache,
+) -> Option<(f64, bool, f64)> {
+    let (codes, edges, snap) = input.refinement_bins.as_ref().unwrap().as_ref();
+    let edges = &edges[feature];
+    let mut counts = [0usize; 256];
+    let mut weights = [0.0f64; 256];
+    let mut classes = [[0.0f64; 2]; 256];
+    let mut heads = [usize::MAX; 256];
+    // Each sample belongs to one linked list; only the boundary bin needs revisiting.
+    let mut next = Vec::with_capacity(mask.len());
+    let mut min = f64::INFINITY;
+    let mut max = f64::NEG_INFINITY;
+    let mut missing_count = 0usize;
+    let mut missing_weight = 0.0;
+    let mut missing_class_0 = 0.0;
+    let mut missing_class_1 = 0.0;
+    for (index, (&row, &label)) in mask.iter().zip(&target.labels).enumerate() {
+        let value = input.value(row, feature);
+        let weight = input.sample_weight(row);
+        let bin = codes[feature * input.rows + row] as usize;
+        next.push(heads[bin]); heads[bin] = index;
+        if value.is_nan() {
+            missing_count += 1;
+            missing_weight += weight;
+            if label == 0 { missing_class_0 += weight; } else { missing_class_1 += weight; }
+        } else {
+            min = min.min(value); max = max.max(value);
+            counts[bin] += 1; weights[bin] += weight; classes[bin][label] += weight;
+        }
+    }
+    if min >= max { split_cache.mark_constant(feature); return None; }
+    let unit = ((rng.get_u64() ^ input.extra_seed.wrapping_mul(0x9e37_79b9_7f4a_7c15)) >> 11) as f64
+        * (1.0 / ((1u64 << 53) as f64));
+    let mut threshold = min * (1.0 - unit) + max * unit;
+    let boundary = edges.partition_point(|edge| threshold > *edge);
+    let mut low_count = counts[..boundary].iter().sum::<usize>();
+    let mut low_weight = weights[..boundary].iter().sum::<f64>();
+    let mut low_class_0 = classes[..boundary].iter().map(|v| v[0]).sum::<f64>();
+    let mut low_class_1 = classes[..boundary].iter().map(|v| v[1]).sum::<f64>();
+    if *snap {
+        // Approximate experiment: snap the raw-value threshold down to a bin edge.
+        if boundary == 0 { return None; }
+        threshold = edges[boundary - 1];
+    } else {
+        let mut index = heads[boundary];
+        while index != usize::MAX {
+            let row = mask.iter().nth(index).copied().unwrap();
+            let label = target.labels[index];
+            if input.value(row, feature) <= threshold {
+                let weight = input.sample_weight(row);
+                low_count += 1; low_weight += weight;
+                if label == 0 { low_class_0 += weight; } else { low_class_1 += weight; }
+            }
+            index = next[index];
+        }
+    }
